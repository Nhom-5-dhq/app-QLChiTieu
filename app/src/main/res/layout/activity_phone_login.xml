<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="← Quay lại"
        android:textSize="16sp"
        android:textColor="#007AFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng nhập bằng Số Điện Thoại"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="32dp" />

    <!-- Khối nhập Số điện thoại -->
    <LinearLayout
        android:id="@+id/layoutPhoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp">

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nhập SĐT (ví dụ: +84987654321)"
            android:inputType="phone"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Gửi mã OTP"
            android:textAllCaps="false"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Khối nhập mã OTP (Mặc định ẩn, gửi OTP thành công mới hiện) -->
    <LinearLayout
        android:id="@+id/layoutOTPInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="32dp">

        <EditText
            android:id="@+id/edtOTP"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nhập mã OTP (6 chữ số)"
            android:inputType="number"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnVerifyOTP"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Xác thực &amp; Đăng nhập"
            android:textAllCaps="false"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</LinearLayout>